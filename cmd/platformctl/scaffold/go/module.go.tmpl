package [[.Name]]

import (
	"[[.Module]]/ext/[[.Name]]/internal/api"
	"[[.Module]]/ext/[[.Name]]/internal/migrations"
	"[[.Module]]/ext/[[.Name]]/internal/store"
	"[[.Module]]/pkg/app"
)

var Definition = app.Definition{
	Name:       "[[.Name]]",
	Migrations: migrations.FS,
	New: func(d app.Deps) (*app.Module, error) {
		return &app.Module{
			Routes: (&api.API{Store: store.New(d.Pool), Auth: d.Auth}).Routes,
		}, nil
	},
}
