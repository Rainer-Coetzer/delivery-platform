# Copy to .env; docker compose reads it automatically.
#
# PROFILE=dev (the compose default) allows insecure local defaults: a dev
# JWT secret, wildcard CORS/WebSocket origins. With any other PROFILE every
# service refuses to boot unless the values below are set properly.
PROFILE=dev

# At least 32 random bytes outside dev, e.g. `openssl rand -base64 48`.
# Every service verifies tokens with it (docs/adr/0001).
JWT_SECRET=

# Comma-separated browser origins allowed to call the gateway, e.g.
# https://app.example.com. Wildcards are rejected outside dev.
ALLOWED_ORIGINS=

# First admin, created at boot if the email isn't registered yet. The dev
# overlay (docker-compose.dev.yml) sets admin@example.com for you; outside
# dev use a 12+ character password.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

GRAFANA_ADMIN_PASSWORD=admin

# Vertical pack (packs/<name>): food, and more to come. Every service in the
# `full` profile must get the same value.
PACK=food
