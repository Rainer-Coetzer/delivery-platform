{
  "title": "Delivery Platform Overview",
  "uid": "delivery-platform-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "HTTP requests/sec by service",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum by (service) (rate(http_requests_total[1m]))", "legendFormat": "{{service}}" }
      ]
    },
    {
      "id": 2,
      "title": "Kafka events consumed/sec by topic",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "sum by (topic) (rate(kafka_events_consumed_total[1m]))", "legendFormat": "{{topic}}" }
      ]
    },
    {
      "id": 3,
      "title": "Kafka events published/sec by service",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "sum by (service) (rate(kafka_events_published_total[1m]))", "legendFormat": "{{service}}" }
      ]
    },
    {
      "id": 4,
      "title": "HTTP error rate (5xx) by service",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "sum by (service) (rate(http_requests_total{status=~\"5..\"}[1m]))", "legendFormat": "{{service}}" }
      ]
    }
  ]
}
